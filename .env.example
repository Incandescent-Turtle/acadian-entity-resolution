# WebTrees database (read by genealogie_acadienne.get_connection). Only needed for `acadian-er snapshot`.
DB_HOST="127.0.0.1"
DB_USER="root"
DB_PASS="..."
DB_NAME="webtrees"
DB_PORT="3306"
# DB_PREFIX="wt_"

# RQ2 LLM backends. Keys are read from the env var named in the YAML config (api_key_env).
OPENROUTER_API_KEY=""
# Cluster / self-hosted OpenAI-compatible server (vLLM, llama.cpp server, ...)
CLUSTER_API_KEY=""
# Ollama runs locally without a key; override the URL if needed.
# OLLAMA_URL="http://localhost:11434"
